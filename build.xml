<project name="juma_wallet" default="compile" basedir=".">
    <target name="clean">
        <delete dir="build/classes"/>
    </target>
    <target name="compile">
        <mkdir dir="build/classes"/>
        <javac srcdir="src" destdir="build/classes" source="17" target="17">
            <classpath>
                <fileset dir="WebContent/WEB-INF/lib">
                    <include name="**/*.jar"/>
                </fileset>
            </classpath>
        </javac>
    </target>

    <target name="war" depends="compile">
        <war destfile="juma_wallet.war" webxml="WebContent/WEB-INF/web.xml">
            <fileset dir="WebContent">
                <include name="**/*.*"/>
            </fileset>
            <classes dir="build/classes"/>
            <lib dir="WebContent/WEB-INF/lib"/>
        </war>
    </target>
</project>